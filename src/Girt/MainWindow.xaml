<Window x:Class="Girt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Girt.Controls"
        xmlns:converters="clr-namespace:Girt.Converters"
        xmlns:models="clr-namespace:Girt.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="850" Width="1350"
        MinHeight="600" MinWidth="950"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseFontStyle}">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BranchPinToggleLabelConverter x:Key="BranchPinToggleLabelConverter" />
        <converters:PushModeGlyphConverter x:Key="PushModeGlyphConverter" />
        <converters:PushModeTooltipConverter x:Key="PushModeTooltipConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshRepositoryCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="52" />
            <!-- Main Content Split -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ================= TOP APP BAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Brand -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Repo Open & Dropdown -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Repo Name & Branch Pill - the branch name itself is capped/ellipsized
                         (see CurrentBranch TextBlock below) so a long branch name can't crowd
                         out the badges/actions that follow it. -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Status / Sync Badges (#to commit, #to push, #to pull) - Auto, not *, so
                         these always render at full size instead of being the thing squeezed. -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer - absorbs leftover space so Right Actions stays pinned right. -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Actions (Fetch, Reset, Refresh, Theme) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border CornerRadius="7"
                            Width="30" Height="30"
                            Margin="0,0,8,0"
                            ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="Girt"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Open Repo & Recent Dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="📂 Open"
                            Style="{StaticResource StandardButtonStyle}"
                            Command="{Binding OpenFolderPickerCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Open local repository folder" />

                    <ComboBox Width="180"
                              ItemsSource="{Binding RecentRepositories}"
                              SelectedItem="{Binding RepositoryPath, Mode=OneWay}"
                              SelectionChanged="OnRecentRepoSelected"
                              Background="{DynamicResource InputBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              VerticalAlignment="Center"
                              ToolTip="Recent repositories" />
                </StackPanel>

                <!-- Current Repository / Branch Pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- Repo Name -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RepositoryName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Active Branch - name is capped/ellipsized (full name in the tooltip) so
                         a long branch name can't push the badges/actions after it out of view. -->
                    <Border Background="{DynamicResource ActiveItemHighlightBrush}"
                            BorderBrush="{DynamicResource BorderAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            ToolTip="{Binding CurrentBranch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⑂ "
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentBranch}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       VerticalAlignment="Center"
                                       MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status & Sync Badges (#to commit, #to push, #to pull) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Changes to commit button/badge -->
                    <Button Command="{Binding ShowWorkingChangesViewCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            Padding="0" Margin="0,0,8,0"
                            ToolTip="Click to open Staged / Unstaged changes and commit panel">
                        <Border Background="#26F59E0B"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✎ " Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RepoStatus.UncommittedCount, StringFormat='{}{0} to commit'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Toggles whether the pill below reviews first or pushes immediately;
                         the choice is persisted so it only has to be set once. -->
                    <Button Command="{Binding ToggleReviewBeforePushCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            Content="{Binding PushPillOpensReview, Converter={StaticResource PushModeGlyphConverter}}"
                            FontSize="12"
                            Padding="4,2"
                            Margin="0,0,4,0"
                            ToolTip="{Binding PushPillOpensReview, Converter={StaticResource PushModeTooltipConverter}}" />

                    <!-- Waiting to push button/badge - opens the review dialog or pushes
                         immediately depending on the mode toggled above. -->
                    <Button Command="{Binding PushPillClickedCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            Padding="0" Margin="0,0,8,0"
                            ToolTip="{Binding PushPillOpensReview, Converter={StaticResource PushModeTooltipConverter}}">
                        <Border Background="#263B82F6"
                                BorderBrush="#3B82F6"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇡ " Foreground="#3B82F6" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RepoStatus.AheadCount, StringFormat='{}{0} to push'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- To be pulled button/badge -->
                    <Button Command="{Binding PullCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Click to pull remote commits into local branch">
                        <Border Background="#2610B981"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇣ " Foreground="#10B981" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RepoStatus.BehindCount, StringFormat='{}{0} to pull'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Working indicator - shown for both the blocking overlay case (IsLoading)
                         and silent background refreshes (IsBackgroundBusy), so there's always
                         some visible feedback that something is happening even when nothing is
                         blocking input. Text follows StatusMessage rather than a static label,
                         since that's already set to something specific by whatever is running. -->
                    <Border Background="{DynamicResource ActiveItemHighlightBrush}"
                            BorderBrush="{DynamicResource BorderAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ " Foreground="{DynamicResource TextAccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Actions: Branch View Mode, Fetch, Reset HEAD, Refresh, Theme -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Active Branch Isolation Indicator Pill & Reset -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CommitHistory.IsBranchIsolated, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 Isolated: " Foreground="#3B82F6" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CommitHistory.IsolatedTargetDescription}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            <Button Content="✕ Show All"
                                    Style="{StaticResource ToolButtonStyle}"
                                    Command="{Binding CommitHistory.ClearIsolationCommand}"
                                    Padding="4,1"
                                    FontSize="10"
                                    ToolTip="Clear branch isolation and show all commits vivid" />
                        </StackPanel>
                    </Border>

                    <Button Content="⬇ Fetch"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding FetchAllCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Fetch all remotes and prune deleted branches" />

                    <Button Content="↺ Reset HEAD"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding ShowResetDialogCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Reset HEAD to bring back or undo commits" />

                    <Button Content="🔄 Refresh (F5)"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding RefreshRepositoryCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Refresh repository status and commit log (Shortcut: F5)" />

                    <CheckBox Content="Auto"
                              IsChecked="{Binding AutoRefresh}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              ToolTip="When checked, an external change to .git (another tool, a background sync) triggers a full refresh automatically. Off by default - only the pills (ahead/behind/uncommitted/branch) update on their own; your own actions here always update immediately regardless of this." />

                    <Button Content="🌓 Theme"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Toggle Light / Dark mode (persisted automatically)" />

                    <Button Content="⚙ Settings"
                            Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings: minimize behavior, branch tree click mode, git identity" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY CONTENT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Branches) -->
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="450" />
                <!-- Splitter -->
                <ColumnDefinition Width="4" />
                <!-- Right Main Area (Commits Log OR Working Changes) -->
                <ColumnDefinition Width="*" MinWidth="550" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,8">
                    <Grid.RowDefinitions>
                        <!-- Navigation Switcher (History vs Working Changes) -->
                        <RowDefinition Height="Auto" />
                        <!-- Header & New Branch Action -->
                        <RowDefinition Height="Auto" />
                        <!-- Branch Search Filter -->
                        <RowDefinition Height="Auto" />
                        <!-- Branch Lists -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- View Navigation Tabs -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding ShowHistoryViewCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="0,0,4,0"
                                Padding="6,6"
                                FontWeight="SemiBold"
                                ToolTip="View commit history log and branch DAG graph">
                            <TextBlock Text="⑂ Show Commits" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding ShowWorkingChangesViewCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                Margin="4,0,0,0"
                                Padding="6,6"
                                FontWeight="SemiBold"
                                ToolTip="View staged and unstaged working tree changes">
                            <TextBlock Text="{Binding RepoStatus.UncommittedCount, StringFormat='✎ Changes ({0})'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Branches Header -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="BRANCHES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Content="+ New Branch"
                                Style="{StaticResource ToolButtonStyle}"
                                Command="{Binding ShowCreateBranchDialogCommand}"
                                HorizontalAlignment="Right"
                                ToolTip="Create a new branch" />
                    </Grid>

                    <!-- Search Filter Box -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <TextBox Text="{Binding BranchList.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="Filter branches..." />
                    </Grid>

                    <!-- Branches Tree / List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- NEW BRANCHES (DISCOVERED ON REFRESH / FETCH) -->
                            <Border Visibility="{Binding BranchList.HasNewBranches, Converter={StaticResource BoolToVisConverter}}"
                                    Background="#1E10B981"
                                    BorderBrush="#10B981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding BranchList.NewBranches.Count, StringFormat='✨ NEW BRANCHES ({0})'}"
                                                   Foreground="#10B981"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Dismiss"
                                                Style="{StaticResource ToolButtonStyle}"
                                                FontSize="10"
                                                Padding="4,0"
                                                Command="{Binding BranchList.ClearNewBranchesCommand}"
                                                HorizontalAlignment="Right"
                                                ToolTip="Dismiss new branches list" />
                                    </Grid>
                                    <ListBox ItemsSource="{Binding BranchList.NewBranches}"
                                             Style="{StaticResource ModernListBoxStyle}"
                                             ItemContainerStyle="{StaticResource BranchListBoxItemStyle}"
                                             PreviewMouseWheel="OnBranchListPreviewMouseWheel">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GitBranch}">
                                                <Grid Margin="2,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="Checkout"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            FontSize="11"
                                                            Padding="6,2"
                                                            Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- LOCAL BRANCHES GROUP -->
                            <Expander IsExpanded="{Binding BranchList.IsLocalExpanded}"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,8">
                              <Expander.Header>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="Local Branches" VerticalAlignment="Center" />
                                  <!-- Direct binding, no ContextMenu/Popup indirection - reliably reflects and flips the mode. -->
                                  <Button Grid.Column="1"
                                          Style="{StaticResource ToolButtonStyle}"
                                          FontSize="10"
                                          FontWeight="Normal"
                                          Padding="4,1"
                                          Command="{Binding BranchList.ToggleGroupBranchesIntoFoldersCommand}"
                                          ToolTip="Toggle grouping local branches into folders by '/' in their name">
                                    <TextBlock>
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Text" Value="🗂 Folders" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding BranchList.GroupBranchesIntoFolders}" Value="True">
                                              <Setter Property="Text" Value="☰ Flat" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </Button>
                                </Grid>
                              </Expander.Header>
                              <Grid>
                                <ListBox ItemsSource="{Binding BranchList.FilteredLocalBranches}"
                                         SelectedItem="{Binding BranchList.SelectedBranch}"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource BranchListBoxItemStyle}"
                                         PreviewMouseWheel="OnBranchListPreviewMouseWheel"
                                         MouseDoubleClick="OnLocalBranchDoubleClicked"
                                         Visibility="{Binding BranchList.GroupBranchesIntoFolders, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitBranch}">
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Context menu is per-row (bound to {Binding} = this branch), not the
                                                     ListBox's SelectedItem, since right-click doesn't change selection. -->
                                                <Grid.ContextMenu>
                                                    <ContextMenu Opened="OnBranchContextMenuOpened">
                                                        <MenuItem Name="GroupIntoFoldersMenuItem"
                                                                  Header="🗂 Group into Folders"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <MenuItem Name="ShowAsFlatListMenuItem"
                                                                  Header="☰ Show as Flat List"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <Separator />
                                                        <MenuItem Header="{Binding IsPinned, Converter={StaticResource BranchPinToggleLabelConverter}}"
                                                                  Click="OnTogglePinBranchClicked" />
                                                        <Separator />
                                                        <MenuItem Name="DimToForkMenuItem"
                                                                  Header="🔍 Dim to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.DimToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Name="HideToForkMenuItem"
                                                                  Header="👁 Hide to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.HideToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Name="ShowAllMenuItem"
                                                                  Header="✕ Show All Commits (Reset)"
                                                                  Click="OnClearIsolationClicked" />
                                                        <Separator />
                                                        <MenuItem Header="Checkout Branch"
                                                                  Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="🔀 Merge into current branch...">
                                                            <MenuItem Header="Merge (Default)"
                                                                      Command="{Binding DataContext.MergeIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Squash and Merge..."
                                                                      Command="{Binding DataContext.MergeSquashIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Merge (--no-ff)..."
                                                                      Command="{Binding DataContext.MergeNoFfIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="⎇ Rebase current branch on this branch..."
                                                                  Command="{Binding DataContext.RebaseCurrentBranchOnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="↺ Reset current branch to this branch..."
                                                                  Command="{Binding DataContext.ShowResetDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="📋 Copy Branch Name"
                                                                  Command="{Binding DataContext.CopyBranchNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="Delete Branch..."
                                                                  Command="{Binding DataContext.BranchList.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <!-- Active Head / Pinned Indicator -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="● "
                                                               Foreground="#10B981"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="📌 "
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Checkout Quick Action Button -->
                                                <Button Grid.Column="2"
                                                        Content="Checkout"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontSize="11"
                                                        Padding="4,1"
                                                        Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Grouped-into-folders presentation of the same local branches - a real
                                     TreeView (native expand/collapse chevron via BranchTreeViewItemStyle,
                                     indentation from nesting rather than a hand-computed Depth+margin). -->
                                <TreeView ItemsSource="{Binding BranchList.LocalBranchTree}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ItemContainerStyle="{StaticResource BranchTreeViewItemStyle}"
                                          PreviewMouseWheel="OnBranchListPreviewMouseWheel"
                                          MouseDoubleClick="OnLocalBranchDoubleClicked"
                                          Visibility="{Binding BranchList.GroupBranchesIntoFolders, Converter={StaticResource BoolToVisConverter}}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:BranchTreeItem}" ItemsSource="{Binding Children}">
                                            <Grid Margin="2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.ContextMenu>
                                                    <!-- Leaf-only actions are hidden on folder rows via IsFolder -->
                                                    <ContextMenu Opened="OnBranchContextMenuOpened">
                                                        <MenuItem Header="☰ Show as Flat List"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <Separator Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Name="PinMenuItem"
                                                                  Header="{Binding Branch.IsPinned, Converter={StaticResource BranchPinToggleLabelConverter}}"
                                                                  Click="OnTogglePinBranchClicked" />
                                                        <Separator Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Name="DimToForkMenuItem"
                                                                  Header="🔍 Dim to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.DimToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}" />
                                                        <MenuItem Name="HideToForkMenuItem"
                                                                  Header="👁 Hide to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.HideToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}" />
                                                        <MenuItem Name="ShowAllMenuItem"
                                                                  Header="✕ Show All Commits (Reset)"
                                                                  Click="OnClearIsolationClicked" />
                                                        <MenuItem Header="Checkout Branch"
                                                                  Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Header="📋 Copy Branch Name"
                                                                  Command="{Binding DataContext.CopyBranchNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Header="Delete Branch..."
                                                                  Command="{Binding DataContext.BranchList.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <!-- Folder icon/name. The chevron (BranchTreeViewItemStyle's Expander)
                                                     always toggles on one click; clicking this row body toggles on
                                                     either one or two clicks per Settings > "Expand folders on". -->
                                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Background="Transparent"
                                                            MouseLeftButtonDown="OnBranchFolderRowMouseDown"
                                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="📁 " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Active-head / pinned indicator (leaf branches only). FallbackValue matters here:
                                                     on a folder row, Branch is null, so Branch.IsCurrent/IsPinned can't be evaluated
                                                     at all - without an explicit fallback, WPF leaves Visibility untouched rather
                                                     than treating the missing value as false, which defaults it to Visible and
                                                     shows the dot/pin on every folder row. -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="● "
                                                               Foreground="#10B981"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Branch.IsCurrent, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />
                                                    <TextBlock Text="📌 "
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Branch.IsPinned, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />

                                                <!-- Checkout Quick Action Button (leaf branches only, and not the one already
                                                     checked out - CanCheckout covers both, unlike the plain IsFolder check this
                                                     used to use). -->
                                                <Button Grid.Column="2"
                                                        Content="Checkout"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontSize="11"
                                                        Padding="4,1"
                                                        Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Branch}"
                                                        Visibility="{Binding CanCheckout, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                              </Grid>
                            </Expander>

                            <!-- REMOTE BRANCHES GROUP -->
                            <Expander IsExpanded="{Binding BranchList.IsRemoteExpanded}"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontWeight="SemiBold"
                                      Margin="0,8,0,0">
                              <Expander.Header>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="Remote Branches" VerticalAlignment="Center" />
                                  <Button Grid.Column="1"
                                          Style="{StaticResource ToolButtonStyle}"
                                          FontSize="10"
                                          FontWeight="Normal"
                                          Padding="4,1"
                                          Command="{Binding BranchList.ToggleGroupBranchesIntoFoldersCommand}"
                                          ToolTip="Toggle grouping remote branches into folders by '/' in their name">
                                    <TextBlock>
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Text" Value="🗂 Folders" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding BranchList.GroupBranchesIntoFolders}" Value="True">
                                              <Setter Property="Text" Value="☰ Flat" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </Button>
                                </Grid>
                              </Expander.Header>
                              <Grid>
                                <ListBox ItemsSource="{Binding BranchList.FilteredRemoteBranches}"
                                         SelectedItem="{Binding BranchList.SelectedBranch}"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource BranchListBoxItemStyle}"
                                         PreviewMouseWheel="OnBranchListPreviewMouseWheel"
                                         MouseDoubleClick="OnLocalBranchDoubleClicked"
                                         Visibility="{Binding BranchList.GroupBranchesIntoFolders, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitBranch}">
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Context menu is per-row (bound to {Binding} = this branch), not the
                                                     ListBox's SelectedItem, since right-click doesn't change selection. -->
                                                <Grid.ContextMenu>
                                                    <ContextMenu Opened="OnBranchContextMenuOpened">
                                                        <MenuItem Name="GroupIntoFoldersMenuItem"
                                                                  Header="🗂 Group into Folders"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <MenuItem Name="ShowAsFlatListMenuItem"
                                                                  Header="☰ Show as Flat List"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <Separator />
                                                        <MenuItem Name="DimToForkMenuItem"
                                                                  Header="🔍 Dim to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.DimToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Name="HideToForkMenuItem"
                                                                  Header="👁 Hide to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.HideToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Name="ShowAllMenuItem"
                                                                  Header="✕ Show All Commits (Reset)"
                                                                  Click="OnClearIsolationClicked" />
                                                        <Separator />
                                                        <MenuItem Header="{Binding IsPinned, Converter={StaticResource BranchPinToggleLabelConverter}}"
                                                                  Click="OnTogglePinBranchClicked" />
                                                        <Separator />
                                                        <MenuItem Header="Checkout as Local Branch..."
                                                                  Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="🔀 Merge into current branch...">
                                                            <MenuItem Header="Merge (Default)"
                                                                      Command="{Binding DataContext.MergeIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Squash and Merge..."
                                                                      Command="{Binding DataContext.MergeSquashIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Merge (--no-ff)..."
                                                                      Command="{Binding DataContext.MergeNoFfIntoCurrentBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <MenuItem Header="⎇ Rebase current branch on this branch..."
                                                                  Command="{Binding DataContext.RebaseCurrentBranchOnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="↺ Reset current branch to this branch..."
                                                                  Command="{Binding DataContext.ShowResetDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="📋 Copy Branch Name"
                                                                  Command="{Binding DataContext.CopyBranchNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="📌 "
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="Checkout"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontSize="11"
                                                        Padding="4,1"
                                                        Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Grouped-into-folders presentation of the same remote branches -->
                                <TreeView ItemsSource="{Binding BranchList.RemoteBranchTree}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ItemContainerStyle="{StaticResource BranchTreeViewItemStyle}"
                                          PreviewMouseWheel="OnBranchListPreviewMouseWheel"
                                          MouseDoubleClick="OnLocalBranchDoubleClicked"
                                          Visibility="{Binding BranchList.GroupBranchesIntoFolders, Converter={StaticResource BoolToVisConverter}}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:BranchTreeItem}" ItemsSource="{Binding Children}">
                                            <Grid Margin="2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.ContextMenu>
                                                    <ContextMenu Opened="OnBranchContextMenuOpened">
                                                        <MenuItem Header="☰ Show as Flat List"
                                                                  Click="OnToggleGroupBranchesIntoFoldersClicked" />
                                                        <Separator Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Name="PinMenuItem"
                                                                  Header="{Binding Branch.IsPinned, Converter={StaticResource BranchPinToggleLabelConverter}}"
                                                                  Click="OnTogglePinBranchClicked" />
                                                        <Separator Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Name="DimToForkMenuItem"
                                                                  Header="🔍 Dim to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.DimToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}" />
                                                        <MenuItem Name="HideToForkMenuItem"
                                                                  Header="👁 Hide to Trunk Fork (Isolate branch)"
                                                                  Command="{Binding DataContext.CommitHistory.HideToForkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}" />
                                                        <MenuItem Name="ShowAllMenuItem"
                                                                  Header="✕ Show All Commits (Reset)"
                                                                  Click="OnClearIsolationClicked" />
                                                        <MenuItem Header="Checkout as Local Branch..."
                                                                  Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                        <MenuItem Header="📋 Copy Branch Name"
                                                                  Command="{Binding DataContext.CopyBranchNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Branch}"
                                                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <!-- Folder icon/name. The chevron (BranchTreeViewItemStyle's Expander)
                                                     always toggles on one click; clicking this row body toggles on
                                                     either one or two clicks per Settings > "Expand folders on". -->
                                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Background="Transparent"
                                                            MouseLeftButtonDown="OnBranchFolderRowMouseDown"
                                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="📁 " FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Pinned indicator (leaf branches only) - FallbackValue matters here, same reason
                                                     as the local branch tree's active-head/pinned indicator above. -->
                                                <TextBlock Grid.Column="0"
                                                           Text="📌 "
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding Branch.IsPinned, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}" />

                                                <Button Grid.Column="2"
                                                        Content="Checkout"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontSize="11"
                                                        Padding="4,1"
                                                        Command="{Binding DataContext.BranchList.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Branch}"
                                                        Visibility="{Binding CanCheckout, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                              </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- VERTICAL SPLITTER -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE" />

            <!-- ================= RIGHT MAIN AREA (VIEW 1: COMMIT HISTORY) ================= -->
            <Grid Grid.Column="2" Visibility="{Binding IsHistoryView, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <!-- Commits History Log (Top) -->
                    <RowDefinition Height="3*" MinHeight="220" />
                    <!-- Splitter -->
                    <RowDefinition Height="4" />
                    <!-- Commit Detail & Diff (Bottom) -->
                    <RowDefinition Height="2*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- TOP: COMMITS TABLE WITH COLUMN SEARCH INPUTS -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <!-- Per-Column Filter Bar -->
                        <RowDefinition Height="38" />
                        <!-- Commits List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- PER-COLUMN FILTER BAR -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Graph spacer -->
                                <ColumnDefinition Width="100" />
                                <!-- Message Search -->
                                <ColumnDefinition Width="450" />
                                <!-- Author Search -->
                                <ColumnDefinition Width="150" />
                                <!-- Date Search -->
                                <ColumnDefinition Width="130" />
                                <!-- SHA Search -->
                                <ColumnDefinition Width="90" />
                                <!-- Clear & Count -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Filters 🔍"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />

                            <!-- Filter by Message -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding CommitHistory.FilterSubject, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="2,0"
                                     Padding="6,3"
                                     FontSize="12"
                                     ToolTip="Filter by commit message..." />

                            <!-- Filter by Author -->
                            <TextBox Grid.Column="2"
                                     Text="{Binding CommitHistory.FilterAuthor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="2,0"
                                     Padding="6,3"
                                     FontSize="12"
                                     ToolTip="Filter by author..." />

                            <!-- Filter by Date -->
                            <TextBox Grid.Column="3"
                                     Text="{Binding CommitHistory.FilterDate, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="2,0"
                                     Padding="6,3"
                                     FontSize="12"
                                     ToolTip="Filter by date..." />

                            <!-- Filter by SHA -->
                            <TextBox Grid.Column="4"
                                     Text="{Binding CommitHistory.FilterSha, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="2,0"
                                     Padding="6,3"
                                     FontSize="12"
                                     ToolTip="Filter by SHA..." />

                            <!-- Clear Filters Button & Count -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="✖ Clear"
                                        Style="{StaticResource ToolButtonStyle}"
                                        FontSize="11"
                                        Padding="4,2"
                                        Command="{Binding CommitHistory.ClearFiltersCommand}"
                                        Margin="0,0,8,0"
                                        ToolTip="Clear all column search filters" />

                                <TextBlock Text="{Binding CommitHistory.FilteredCommits.Count, StringFormat='{}{0} commits'}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Commits DataGrid / ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding CommitHistory.FilteredCommits}"
                              SelectedItem="{Binding CommitHistory.SelectedCommit}"
                              Background="{DynamicResource WindowBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              VirtualizingPanel.CacheLength="10,10"
                              VirtualizingPanel.CacheLengthUnit="Item">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Opacity" Value="{Binding DisplayOpacity}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <!-- Branch Isolation Options -->
                                <MenuItem Header="🔍 Dim to Trunk Fork (Isolate this branch)"
                                          Command="{Binding CommitHistory.DimToForkCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                <MenuItem Header="👁 Hide to Trunk Fork (Isolate this branch)"
                                          Command="{Binding CommitHistory.HideToForkCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                <MenuItem Header="✕ Show All Commits (Reset)"
                                          Command="{Binding CommitHistory.ClearIsolationCommand}"
                                          Visibility="{Binding CommitHistory.IsBranchIsolated, Converter={StaticResource BoolToVisConverter}}" />
                                <Separator />

                                <!-- Copy Submenu -->
                                <MenuItem Header="📋 Copy">
                                    <MenuItem Header="Commit SHA (Full)"
                                              Command="{Binding CopyCommitShaCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                    <MenuItem Header="Commit SHA (Short)"
                                              Command="{Binding CopyCommitShortShaCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                    <MenuItem Header="Commit Message"
                                              Command="{Binding CopyCommitMessageCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                    <MenuItem Header="Author Details"
                                              Command="{Binding CopyCommitAuthorCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                </MenuItem>
                                <Separator />

                                <!-- Revert Commit -->
                                <MenuItem Header="↩ Revert this commit..."
                                          Command="{Binding RevertCommitCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />

                                <!-- Cherry Pick Commit -->
                                <MenuItem Header="🍒 Cherry-pick this commit..."
                                          Command="{Binding CherryPickCommitCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                <Separator />

                                <!-- Merge into current branch -->
                                <MenuItem Header="🔀 Merge into current branch...">
                                    <MenuItem Header="Merge (Default)"
                                              Command="{Binding MergeIntoCurrentBranchCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                    <MenuItem Header="Squash and Merge..."
                                              Command="{Binding MergeSquashIntoCurrentBranchCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                    <MenuItem Header="Merge (--no-ff)..."
                                              Command="{Binding MergeNoFfIntoCurrentBranchCommand}"
                                              CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                                </MenuItem>

                                <!-- Rebase current branch on this commit -->
                                <MenuItem Header="⎇ Rebase current branch on this commit..."
                                          Command="{Binding RebaseCurrentBranchOnCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />

                                <!-- Reset current branch to here -->
                                <MenuItem Header="↺ Reset current branch to here..."
                                          Command="{Binding ShowResetDialogCommand}"
                                          CommandParameter="{Binding CommitHistory.SelectedCommit}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <!-- Graph DAG Column -->
                                <GridViewColumn Header="Graph" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:GitCommit}">
                                            <controls:CommitGraphCanvas Commit="{Binding}"
                                                                        Width="100" Height="28" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Message & Ref Badges -->
                                <GridViewColumn Header="Message" Width="450">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:GitCommit}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Ref Badges (Branches/Tags) -->
                                                <ItemsControl ItemsSource="{Binding Refs}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:GitRefBadge}">
                                                            <Border Background="{Binding BackgroundColor, Converter={StaticResource HexToBrushConverter}}"
                                                                    CornerRadius="4"
                                                                    Padding="5,1"
                                                                    Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#FFFFFF"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Subject Text -->
                                                <TextBlock Text="{Binding Subject}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Author -->
                                <GridViewColumn Header="Author" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:GitCommit}">
                                            <TextBlock Text="{Binding AuthorName}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Date -->
                                <GridViewColumn Header="Date" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:GitCommit}">
                                            <TextBlock Text="{Binding RelativeDate}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Short Hash -->
                                <GridViewColumn Header="SHA" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:GitCommit}">
                                            <TextBlock Text="{Binding ShortHash}"
                                                       FontFamily="Consolas, monospace"
                                                       Foreground="{DynamicResource TextAccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- HORIZONTAL SPLITTER -->
                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              Cursor="SizeNS" />

                <!-- BOTTOM: COMMIT DETAILS & DIFF VIEWER -->
                <Grid Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <!-- Changed Files & Metadata (Left) -->
                        <ColumnDefinition Width="340" MinWidth="240" MaxWidth="500" />
                        <!-- Diff Splitter -->
                        <ColumnDefinition Width="4" />
                        <!-- Diff Viewer (Right) -->
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Metadata & Files List -->
                    <Grid Grid.Column="0" Margin="12">
                        <Grid.RowDefinitions>
                            <!-- Commit Metadata Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Files Label -->
                            <RowDefinition Height="Auto" />
                            <!-- Files List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Commit Header Info -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CommitDetail.Commit.Subject}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />

                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11">
                                    <Run Text="{Binding CommitDetail.Commit.AuthorName}" FontWeight="SemiBold" />
                                    <Run Text=" authored on " />
                                    <Run Text="{Binding CommitDetail.Commit.Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                </TextBlock>

                                <TextBlock Text="{Binding CommitDetail.Commit.Hash}"
                                           FontFamily="Consolas, monospace"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Changed Files Section Header -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <TextBlock Text="{Binding CommitDetail.ChangedFiles.Count, StringFormat='CHANGED FILES ({0})'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- Files List -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding CommitDetail.ChangedFiles}"
                                 SelectedItem="{Binding CommitDetail.SelectedFile}"
                                 Style="{StaticResource ModernListBoxStyle}"
                                 ItemContainerStyle="{StaticResource BranchListBoxItemStyle}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add to .gitignore"
                                              Command="{Binding CommitDetail.AddToGitIgnoreCommand}"
                                              CommandParameter="{Binding CommitDetail.SelectedFile}" />
                                    <MenuItem Header="Add folder to .gitignore"
                                              ItemsSource="{Binding CommitDetail.SelectedFile.AncestorFolders}">
                                        <!-- Command+RelativeSource across a submenu popup boundary has proven unreliable
                                             elsewhere in this app (see OnTogglePinBranchClicked) - resolve via a code-behind
                                             Click handler off the clicked item's own DataContext (the folder path) instead. -->
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding}" />
                                                <EventSetter Event="Click" Handler="OnIgnoreFolderInCommitDetailClicked" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="Add extension to .gitignore (*.ext)"
                                              Command="{Binding CommitDetail.IgnoreExtensionCommand}"
                                              CommandParameter="{Binding CommitDetail.SelectedFile}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GitFileDiff}">
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Badge (M, A, D, R) -->
                                        <Border Grid.Column="0"
                                                Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                CornerRadius="3"
                                                Width="16" Height="16"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StatusBadge}"
                                                       Foreground="#FFFFFF"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- File Path -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <!-- Stats (+ / -) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Additions, StringFormat='+{0} '}"
                                                       Foreground="#10B981"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Deletions, StringFormat='-{0}'}"
                                                       Foreground="#EF4444"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Vertical Splitter between files and diff -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  Cursor="SizeWE" />

                    <!-- Right: Unified Diff Viewer -->
                    <controls:DiffViewerControl Grid.Column="2"
                                                DataContext="{Binding CommitDetail}" />
                </Grid>
            </Grid>

            <!-- ================= RIGHT MAIN AREA (VIEW 2: WORKING CHANGES & COMMIT PANEL) ================= -->
            <Grid Grid.Column="2" Visibility="{Binding IsWorkingChangesView, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- Left: Staged & Unstaged Files + Commit Box -->
                    <ColumnDefinition Width="380" MinWidth="300" MaxWidth="550" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="4" />
                    <!-- Right: Working Tree File Diff Viewer -->
                    <ColumnDefinition Width="*" MinWidth="350" />
                </Grid.ColumnDefinitions>

                <!-- Left: Staging & Commit Panel -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Top Navigation / Actions -->
                            <RowDefinition Height="Auto" />
                            <!-- Unstaged Files Group (TOP) -->
                            <RowDefinition Height="*" MinHeight="100" />
                            <!-- Staged Files Group (MIDDLE) -->
                            <RowDefinition Height="Auto" MaxHeight="240" MinHeight="100" />
                            <!-- Commit Message Box (BOTTOM) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="WORKING TREE CHANGES"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding WorkingChanges.StashCount, StringFormat='📥 Pop Stash ({0})'}"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding WorkingChanges.StashPopCommand}"
                                        IsEnabled="{Binding WorkingChanges.HasStashes}"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="0,0,6,0"
                                        ToolTip="Pop top stash onto working tree (git stash pop)" />

                                <Button Content="Stage All ⬇"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding WorkingChanges.StageAllCommand}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextAccentBrush}"
                                        FontSize="11"
                                        Padding="6,2"
                                        ToolTip="Stage all unstaged files" />
                            </StackPanel>
                        </Grid>

                        <!-- UNSTAGED FILES (Row 1 - TOP) -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding WorkingChanges.UnstagedFiles.Count, StringFormat='UNSTAGED CHANGES ({0})'}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center" />

                                    <Button Content="Stage All ⬇"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Command="{Binding WorkingChanges.StageAllCommand}"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Padding="4,1"
                                            ToolTip="Stage all unstaged files" />
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding WorkingChanges.UnstagedFiles}"
                                         SelectedItem="{Binding WorkingChanges.SelectedFile}"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource BranchListBoxItemStyle}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Stage File"
                                                      Command="{Binding WorkingChanges.StageFileCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                            <MenuItem Header="Discard Changes..."
                                                      Command="{Binding WorkingChanges.DiscardChangesCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                            <Separator />
                                            <MenuItem Header="Add to .gitignore"
                                                      Command="{Binding WorkingChanges.AddToGitIgnoreCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                            <MenuItem Header="Add folder to .gitignore"
                                                      ItemsSource="{Binding WorkingChanges.SelectedFile.AncestorFolders}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding}" />
                                                        <EventSetter Event="Click" Handler="OnIgnoreFolderInWorkingChangesClicked" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <MenuItem Header="Add extension to .gitignore (*.ext)"
                                                      Command="{Binding WorkingChanges.IgnoreExtensionCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitWorkingFile}">
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="3"
                                                        Width="16" Height="16"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusBadge}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- File Path -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Stage button -->
                                                <Button Grid.Column="2"
                                                        Content="⬇ Stage"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"
                                                        Padding="6,1"
                                                        Foreground="#10B981"
                                                        Command="{Binding DataContext.WorkingChanges.StageFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Stage this file" />

                                                <!-- Discard button (x) -->
                                                <Button Grid.Column="3"
                                                        Content="✖"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontSize="10"
                                                        Padding="4,0"
                                                        Margin="4,0,0,0"
                                                        Foreground="#EF4444"
                                                        Command="{Binding DataContext.WorkingChanges.DiscardChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Discard changes in this file" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- STAGED FILES (Row 2 - MIDDLE) -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding WorkingChanges.StagedFiles.Count, StringFormat='STAGED CHANGES ({0})'}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📦 Stash Staged"
                                                Style="{StaticResource ToolButtonStyle}"
                                                Command="{Binding WorkingChanges.StashStagedCommand}"
                                                IsEnabled="{Binding WorkingChanges.HasStagedFiles}"
                                                FontSize="11"
                                                Padding="6,1"
                                                Margin="0,0,6,0"
                                                ToolTip="Stash currently staged changes (git stash push --staged)" />

                                        <Button Content="Unstage All ⬆"
                                                Style="{StaticResource ToolButtonStyle}"
                                                Command="{Binding WorkingChanges.UnstageAllCommand}"
                                                FontSize="11"
                                                Padding="6,1"
                                                ToolTip="Unstage all staged files" />
                                    </StackPanel>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding WorkingChanges.StagedFiles}"
                                         SelectedItem="{Binding WorkingChanges.SelectedFile}"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource BranchListBoxItemStyle}"
                                         MaxHeight="180">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Unstage File"
                                                      Command="{Binding WorkingChanges.UnstageFileCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                            <Separator />
                                            <MenuItem Header="Add to .gitignore"
                                                      Command="{Binding WorkingChanges.AddToGitIgnoreCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                            <MenuItem Header="Add folder to .gitignore"
                                                      ItemsSource="{Binding WorkingChanges.SelectedFile.AncestorFolders}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding}" />
                                                        <EventSetter Event="Click" Handler="OnIgnoreFolderInWorkingChangesClicked" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <MenuItem Header="Add extension to .gitignore (*.ext)"
                                                      Command="{Binding WorkingChanges.IgnoreExtensionCommand}"
                                                      CommandParameter="{Binding WorkingChanges.SelectedFile}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GitWorkingFile}">
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="3"
                                                        Width="16" Height="16"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusBadge}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- File Path -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Unstage button -->
                                                <Button Grid.Column="2"
                                                        Content="⬆ Unstage"
                                                        Style="{StaticResource ToolButtonStyle}"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"
                                                        Padding="6,1"
                                                        Command="{Binding DataContext.WorkingChanges.UnstageFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Unstage this file" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- COMMIT MESSAGE BOX & ACTION (Row 3 - BOTTOM) -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Commit Message"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6" />

                                <!-- Unified Single Commit Message Box -->
                                <TextBox Text="{Binding WorkingChanges.CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Height="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,10"
                                         ToolTip="Enter commit message (e.g. Fix navbar alignment)..." />

                                <!-- Also push after commit (remembered) -->
                                <CheckBox Content="Also push after commit"
                                          IsChecked="{Binding WorkingChanges.PushAfterCommit}"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          FontSize="11"
                                          Margin="0,0,0,8"
                                          ToolTip="When checked, a successful commit is immediately followed by a push. Remembered across sessions." />

                                <!-- Commit Button -->
                                <Button Content="{Binding CurrentBranch, StringFormat='✓ Commit to {0}'}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding WorkingChanges.CommitCommand}"
                                        Background="#238636"
                                        BorderBrush="#238636"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              Cursor="SizeWE" />

                <!-- Right: Working Tree File Diff Viewer -->
                <Grid Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- File Header / Quick actions -->
                        <RowDefinition Height="42" />
                        <!-- Diff Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WorkingChanges.SelectedFile.DisplayName, FallbackValue='No file selected'}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />

                                <Border Background="{Binding WorkingChanges.SelectedFile.StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        Visibility="{Binding WorkingChanges.SelectedFile, Converter={StaticResource NullToVisConverter}}">
                                    <TextBlock Text="{Binding WorkingChanges.SelectedFile.Status}"
                                               Foreground="#FFFFFF"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Stage File"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding WorkingChanges.StageFileCommand}"
                                        CommandParameter="{Binding WorkingChanges.SelectedFile}"
                                        Visibility="{Binding WorkingChanges.SelectedFile.IsStaged, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"
                                        Margin="0,0,6,0" />

                                <Button Content="Unstage File"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding WorkingChanges.UnstageFileCommand}"
                                        CommandParameter="{Binding WorkingChanges.SelectedFile}"
                                        Visibility="{Binding WorkingChanges.SelectedFile.IsStaged, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Diff Viewer Control -->
                    <controls:DiffViewerControl Grid.Row="1"
                                                DataContext="{Binding WorkingChanges}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <!-- Loading Indicator -->
                <TextBlock Grid.Column="1"
                           Text="⏳ Loading..."
                           Foreground="{DynamicResource TextAccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>

        <!-- ================= MODAL DIALOGS OVERLAY LAYER (FULL WINDOW) ================= -->
        
        <!-- MODAL 1: CREATE NEW BRANCH -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsCreateBranchDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="440"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Create New Branch"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Branch Name:"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource StandardButtonStyle}"
                                Command="{Binding CancelCreateBranchDialogCommand}"
                                Margin="0,0,8,0" />

                        <Button Content="Create Branch"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConfirmCreateBranchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 2: RESET HEAD (SOFT / HARD) -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsResetDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="500"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="↺ Reset HEAD"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ResetTargetDescription, StringFormat='Target: {0}'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextAccentBrush}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Target Ref / Commit SHA:"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />

                    <TextBox Text="{Binding ResetTargetRef, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Select Reset Mode:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <!-- Soft Reset Option -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,8">
                        <RadioButton GroupName="ResetModeGroup"
                                     IsChecked="True"
                                     Command="{Binding SetResetModeCommand}"
                                     CommandParameter="Soft">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Soft (--soft)" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Keeps all changed files staged in your working directory. Perfect for undoing a commit to revise it."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <!-- Hard Reset Option -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,18">
                        <RadioButton GroupName="ResetModeGroup"
                                     Command="{Binding SetResetModeCommand}"
                                     CommandParameter="Hard">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Hard (--hard)" FontWeight="Bold" Foreground="#EF4444" />
                                <TextBlock Text="⚠️ Discards all commits and uncommitted changes back to the target state. Changes cannot be recovered."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource StandardButtonStyle}"
                                Command="{Binding CancelResetDialogCommand}"
                                Margin="0,0,8,0" />

                        <Button Content="Confirm Reset"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConfirmResetCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 3: REVIEW UNPUSHED CHANGES - the combined diff of everything a push would
             send, so the user can see what's going up before committing to it. -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding UnpushedChanges.IsOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="900" Height="600"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding RepoStatus.AheadCount, StringFormat='Review Unpushed Changes ({0} commit(s))'}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding UnpushedChanges.ChangedFiles.Count, StringFormat='CHANGED FILES ({0})'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6" />

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding UnpushedChanges.ChangedFiles}"
                                     SelectedItem="{Binding UnpushedChanges.SelectedFile}"
                                     Style="{StaticResource ModernListBoxStyle}"
                                     ItemContainerStyle="{StaticResource BranchListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GitFileDiff}">
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="3"
                                                    Width="16" Height="16"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StatusBadge}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Additions, StringFormat='+{0} '}" Foreground="#10B981" FontSize="11" />
                                                <TextBlock Text="{Binding Deletions, StringFormat='-{0}'}" Foreground="#EF4444" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      Cursor="SizeWE" />

                        <controls:DiffViewerControl Grid.Column="2"
                                                    DataContext="{Binding UnpushedChanges}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <!-- Coarse reset of everything unpushed, to the upstream branch - for
                             per-commit control instead, use the main "↺ Reset HEAD" toolbar
                             button, which targets a specific commit or branch. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="↺ Soft Reset"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Command="{Binding ResetToUpstreamCommand}"
                                    CommandParameter="Soft"
                                    Margin="0,0,8,0"
                                    ToolTip="Undo all these commits but keep their changes staged" />

                            <Button Content="↺ Hard Reset"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Command="{Binding ResetToUpstreamCommand}"
                                    CommandParameter="Hard"
                                    Foreground="#EF4444"
                                    ToolTip="Permanently discard all these commits and their changes" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close"
                                    Style="{StaticResource StandardButtonStyle}"
                                    Command="{Binding UnpushedChanges.CloseCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="⬆ Push"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PushFromReviewCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: PULL CHOICE - shown only when the branch has diverged from upstream (commits
             on both sides), since a plain pull there silently creates a merge commit. -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsPullChoiceDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="460"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⇣ Branch Has Diverged"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16">
                        <Run Text="Your branch has " />
                        <Run Text="{Binding RepoStatus.AheadCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" />
                        <Run Text=" commit(s) not on " />
                        <Run Text="{Binding RepoStatus.UpstreamBranch, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=", which has " />
                        <Run Text="{Binding RepoStatus.BehindCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" />
                        <Run Text=" commit(s) you don't have. A plain pull here will create a merge commit - pick how to reconcile instead." />
                    </TextBlock>

                    <!-- Merge Option -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Button Command="{Binding ConfirmPullMergeCommand}"
                                Style="{StaticResource ToolButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="0">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Merge" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Combines both histories with a merge commit. Preserves exactly what happened, but adds a merge commit to the log."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Rebase Option -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,16">
                        <Button Command="{Binding ConfirmPullRebaseCommand}"
                                Style="{StaticResource ToolButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="0">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Rebase" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Replays your commit(s) on top of theirs. Keeps history linear with no merge commit, but rewrites your local commit hash(es)."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource StandardButtonStyle}"
                                Command="{Binding CancelPullChoiceDialogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL: SETTINGS -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsSettingsDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480"
                    MaxHeight="640"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="⚙ Settings"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,14" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <CheckBox Content="Minimize to tray"
                                      IsChecked="{Binding Settings.MinimizeToTray}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,6"
                                      ToolTip="When the window is minimized, drop it into the notification area tray icon instead of the taskbar." />
                            <CheckBox Content="Minimize on close (instead of exiting)"
                                      IsChecked="{Binding Settings.MinimizeOnClose}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,6"
                                      ToolTip="Clicking the window's close (X) button hides to tray instead of exiting Girt. Exit fully from the tray icon's context menu." />
                            <CheckBox Content="Auto-refresh when .git changes externally"
                                      IsChecked="{Binding AutoRefresh}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,6"
                                      ToolTip="Same toggle as the 'Auto' checkbox in the toolbar. When off, only the status pills update on external changes; use F5 to refresh fully." />

                            <TextBlock Text="BRANCH TREE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6" />
                            <CheckBox Content="Expand/collapse folders with a single click (uncheck for double-click)"
                                      IsChecked="{Binding Settings.FolderExpandOnSingleClick}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,6"
                                      ToolTip="The small chevron next to a folder always toggles on one click regardless of this setting - this only controls clicking the folder row itself." />

                            <TextBlock Text="GIT IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6" />

                            <TextBlock Text="Global (used everywhere unless a repository overrides it)"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0" Padding="6,4"
                                         Text="{Binding Settings.GlobalUserName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Tag="Name" />
                                <TextBox Grid.Column="1" Margin="4,0,0,0" Padding="6,4"
                                         Text="{Binding Settings.GlobalUserEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Tag="Email" />
                            </Grid>
                            <Button Content="Save Global Identity"
                                    Style="{StaticResource ToolButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14"
                                    Command="{Binding Settings.SaveGlobalIdentityCommand}" />

                            <TextBlock Text="This repository"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0" Padding="6,4"
                                         Text="{Binding Settings.LocalUserName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBox Grid.Column="1" Margin="4,0,0,0" Padding="6,4"
                                         Text="{Binding Settings.LocalUserEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Save Override for This Repo"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding Settings.SaveLocalIdentityOverrideCommand}" />
                                <Button Content="Remove Override"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Command="{Binding Settings.RemoveLocalIdentityOverrideCommand}"
                                        Visibility="{Binding Settings.HasLocalIdentityOverride, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Settings.IdentityStatusMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Settings.IdentityStatusMessage, Converter={StaticResource NullToVisConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Done"
                                Style="{StaticResource StandardButtonStyle}"
                                Command="{Binding CloseSettingsDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL 4: BUSY OVERLAY - blocks input for any long-running operation (checkout,
             opening/switching repos, push/pull/fetch, etc.), all of which set IsLoading. -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="320"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,14" />
                    <ProgressBar IsIndeterminate="True" Height="6" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
