<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>0.4.54</Version>
    <AssemblyVersion>0.4.54.0</AssemblyVersion>
    <FileVersion>0.4.54.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- UseWindowsForms is only here for NotifyIcon (the tray icon). Its implicit global
       "using System.Windows.Forms" collides with WPF's System.Windows on many common names
       (MessageBox, Application, Timer, Color, ...) throughout the codebase - removing just
       that implicit using keeps the assembly reference (so Forms.NotifyIcon etc. still resolve
       via the explicit "Forms =" alias in MainWindow.xaml.cs) without the blanket collision. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- splash.png is loaded manually (see App.xaml.cs) rather than via the <SplashScreen>
         build item - that item's "autoClose" actually closes on the first UI-thread idle, not
         on MainWindow rendering, so any async startup work makes it vanish near-instantly. -->
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
