<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>0.4.31</Version>
    <AssemblyVersion>0.4.31.0</AssemblyVersion>
    <FileVersion>0.4.31.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- UseWindowsForms is only here for NotifyIcon (the tray icon). Its implicit global
       "using System.Windows.Forms" collides with WPF's System.Windows on many common names
       (MessageBox, Application, Timer, Color, ...) throughout the codebase - removing just
       that implicit using keeps the assembly reference (so Forms.NotifyIcon etc. still resolve
       via the explicit "Forms =" alias in MainWindow.xaml.cs) without the blanket collision. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" Exclude="Assets\splash.png" />
    <!-- SplashScreen is a native WPF build action: the image shows immediately (before
         MainWindow even finishes constructing) as a borderless, alpha-shaped window, then
         fades out automatically once the main window is ready - no custom window/code needed. -->
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

</Project>
