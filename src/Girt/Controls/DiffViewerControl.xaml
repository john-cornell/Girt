<UserControl x:Class="Girt.Controls.DiffViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Girt.Converters"
             xmlns:models="clr-namespace:Girt.Models"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <converters:DiffTypeToBackgroundConverter x:Key="DiffBgConverter" />
        <converters:DiffTypeToForegroundConverter x:Key="DiffFgConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:DiffLineToggleLabelConverter x:Key="DiffToggleLabelConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource CardBackgroundBrush}">
        <!-- Empty state when no diff is selected -->
        <TextBlock Text="Select a file to view changes"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding DiffLines.Count, Converter={StaticResource NullToVisConverter}, ConverterParameter=Empty}" />

        <!-- The ScrollViewer must live INSIDE the ItemsControl's template, directly around the
             ItemsPresenter. Wrapped around the ItemsControl from outside (as it used to be), it
             measures the list with unlimited height, which silently switches virtualization
             off: every line got its own row, so a large diff (tens of thousands of lines, since
             the whole file is fetched as context) froze the UI thread and ate gigabytes. -->
        <ItemsControl x:Name="DiffLinesItemsControl"
                      ItemsSource="{Binding DiffLines}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ContextMenuOpening="OnDiffContextMenuOpening">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- One menu for the whole list rather than one per row (each row used to build
                     its own 6-item ContextMenu). OnDiffContextMenuOpening points it at whichever
                     line was right-clicked by setting its DataContext, so the menu items' own
                     bindings and click handlers still see that DiffLine. -->
                <ItemsControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Converter={StaticResource DiffToggleLabelConverter}}"
                                  Click="OnToggleDiffSectionClicked"
                                  Visibility="{Binding CanToggleCollapse, Converter={StaticResource BoolToVisConverter}}" />
                        <MenuItem Header="Show Whole File"
                                  Click="OnExpandAllDiffSectionsClicked" />
                        <Separator />
                        <MenuItem Header="Copy Line(s)" Click="OnCopyLinesClicked" />
                        <Separator Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />
                        <MenuItem Header="Revert Selected Lines"
                                  Click="OnRevertSelectedLinesClicked"
                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />
                    </ContextMenu>
                </ItemsControl.ContextMenu>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DiffLine}">
                        <Border Background="{Binding Converter={StaticResource DiffBgConverter}}"
                                Padding="4,1"
                                SnapsToDevicePixels="True"
                                PreviewMouseLeftButtonDown="OnDiffLineMouseLeftButtonDown"
                                PreviewMouseMove="OnDiffLineMouseMove"
                                PreviewMouseLeftButtonUp="OnDiffLineMouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource TextAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Old Line Number -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding OldLineNumber}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           Margin="0,0,8,0" />

                                <!-- New Line Number -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NewLineNumber}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           Margin="0,0,12,0" />

                                <!-- Line Content -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Text}"
                                           Foreground="{Binding Converter={StaticResource DiffFgConverter}}"
                                           FontFamily="Consolas, Cascadia Code, monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="CollapsedContext">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
